---
import Layout from "../layouts/Layout.astro";
import wslogo from "../assets/img/ws-logo.png";
---

<Layout>
  <section class="px-6 py-20 max-w-7xl mx-auto">
    <!-- Centered Title -->
    <h2
      class="text-[#0B2545] text-3xl md:text-4xl font-extrabold text-center uppercase mb-12"
    >
      Contáctanos
    </h2>

    <!-- Main Container -->
    <div class="flex flex-col md:flex-row items-start gap-12">
      <!-- Text -->
      <div
        class="w-full md:w-1/2 text-center md:text-left flex flex-col justify-center"
      >
        <p class="text-gray-700 text-2xl font-bold leading-7 mb-6">
          Déjanos un mensaje y nos pondremos en contacto contigo en breve. Nuestro equipo está
          listo para brindarte asesoramiento personalizado y guiarte en cada paso
          del proceso.
        </p>
        <p class="text-gray-700 text-2xl font-bold leading-7">
          También puedes contactarnos directamente por teléfono o WhatsApp si lo prefieres.
        </p>
        <!-- Logos al final -->
      <img src={wslogo.src} alt="WhatsApp" class="mt-6 h-15 w-auto self-center md:self-start"/>

      </div>

      <!-- Form -->
      <div class="w-full md:w-1/2 bg-gray-50 rounded-2xl">
        <form>
          <!-- Two-column grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- First Name -->
            <div class="flex flex-col">
              <label for="nombre" class="font-semibold text-[#0B2545] mb-2">
                Nombre
              </label>
              <input
                type="text"
                id="nombre"
                name="nombre"
                placeholder="Tu nombre"
                class="border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-[#F9C74F]"
                required
              />
            </div>

            <!-- Last Name -->
            <div class="flex flex-col">
              <label for="apellido" class="font-semibold text-[#0B2545] mb-2">
                Apellido
              </label>
              <input
                type="text"
                id="apellido"
                name="apellido"
                placeholder="Tu apellido"
                class="border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-[#F9C74F]"
                required
              />
            </div>

            <!-- Email -->
            <div class="flex flex-col">
              <label for="correo" class="font-semibold text-[#0B2545] mb-2">
                Email
              </label>
              <input
                type="email"
                id="correo"
                name="correo"
                placeholder="you@example.com"
                class="border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-[#F9C74F]"
                required
              />
            </div>

            <!-- Phone -->
            <div class="flex flex-col">
              <label for="telefono" class="font-semibold text-[#0B2545] mb-2">
                Teléfono
              </label>
              <input
                type="tel"
                id="telefono"
                name="telefono"
                placeholder="+503 5555-5555"
                class="border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-[#F9C74F]"
              />
            </div>
          </div>

          <!-- Message -->
          <div class="flex flex-col mt-6">
            <label for="mensaje" class="font-semibold text-[#0B2545] mb-2">
              Mensaje
            </label>
            <textarea
              id="mensaje"
              name="mensaje"
              rows="5"
              placeholder="Escribe tu consulta aquí..."
              class="border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-[#F9C74F] resize-none"
              required></textarea>
          </div>

          <!-- Button -->
          <div class="text-center md:text-right mt-4">
            <button
              type="submit"
              class="bg-[#F9C74F] text-[#0B2545] hover:bg-[#f1b500] font-bold px-14 py-3 rounded-full cursor-pointer transition"
            >
              Enviar
            </button>
          </div>
        </form>
      </div>
    </div>
  </section>
</Layout>
